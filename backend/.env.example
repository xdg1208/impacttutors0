# Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER put real credentials in this template file — it is committed to git.

# ── Security (REQUIRED in production) ─────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me-generate-a-random-50+-character-string
DEBUG=False
# Comma-separated hosts the site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed frontend origins (REQUIRED in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Email ──────────────────────────────────────────────────────────
# Gmail SMTP (used as fallback sender and for Django admin mails)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Where admin notifications (new applications / inquiries) are sent.
# Falls back to EMAIL_HOST_USER when unset.
NOTIFICATION_EMAIL=

# ── Telegram (optional — admin notifications) ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database ───────────────────────────────────────────────────────
# Local:      sqlite:///db.sqlite3
# Production:  postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# ── SendPulse (optional — password reset OTP email delivery) ──────
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_FROM_EMAIL=
SENDPULSE_FROM_NAME=Impact Tutors

# ── Tunables ───────────────────────────────────────────────────────
# Examples: 5/hour, 10/day, 20/minute
LOGIN_THROTTLE=10/hour
PASSWORD_RESET_THROTTLE=5/hour
# Hours after session start during which students can mark attendance
ATTENDANCE_MARK_WINDOW_HOURS=6
