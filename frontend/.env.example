# Frontend Environment Variables
# Copy this file to frontend/.env.local for local development.
# The URL must point at the Django API including the /api suffix.

# Local development (Django on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production example:
# NEXT_PUBLIC_API_URL=https://impact-tutors-backend.onrender.com/api

# Used for sitemap.xml / robots.txt absolute URLs
NEXT_PUBLIC_SITE_URL=https://impacttutors.com
